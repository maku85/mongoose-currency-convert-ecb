{
  "name": "mongoose-currency-convert-ecb",
  "version": "0.1.2",
  "description": "ECB currency rate provider for mongoose-currency-convert",
  "keywords": [
    "mongoose",
    "plugin",
    "currency",
    "conversion",
    "exchange-rate",
    "mongodb",
    "typescript",
    "money"
  ],
  "license": "MIT",
  "author": {
    "name": "maku85",
    "email": "makuma85@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maku85/mongoose-currency-convert-ecb.git"
  },
  "homepage": "https://github.com/maku85/mongoose-currency-convert-ecb#readme",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "prepare": "husky",
    "lint": "biome check src --verbose",
    "format": "biome format src --write",
    "prepublishOnly": "pnpm build",
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:dry": "commit-and-tag-version --dry-run",
    "test": "TS_NODE_PROJECT=tsconfig.test.json mocha --config .mocharc.json",
    "test:watch": "TS_NODE_PROJECT=tsconfig.test.json mocha --watch --config .mocharc.json",
    "coverage": "TS_NODE_PROJECT=tsconfig.test.json nyc mocha --config .mocharc.json"
  },
  "peerDependencies": {
    "mongoose-currency-convert": "^0.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.5",
    "@commitlint/config-conventional": "^20.0.0",
    "@types/chai": "^5.2.2",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.7.0",
    "chai": "^6.2.0",
    "chai-as-promised": "^8.0.2",
    "commit-and-tag-version": "^12.6.1",
    "commitlint": "^20.1.0",
    "husky": "^9.1.7",
    "mocha": "^11.7.4",
    "nyc": "^17.1.0",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.5.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "commit-and-tag-version": {
    "types": [
      {
        "type": "feat",
        "section": "Features"
      },
      {
        "type": "fix",
        "section": "Bug Fixes"
      },
      {
        "type": "perf",
        "section": "Performance"
      },
      {
        "type": "revert",
        "section": "Reverts"
      },
      {
        "type": "docs",
        "hidden": true
      },
      {
        "type": "chore",
        "hidden": true
      },
      {
        "type": "refactor",
        "hidden": true
      },
      {
        "type": "test",
        "hidden": true
      }
    ]
  },
  "nyc": {
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "test/**/*.ts",
      "dist/**/*.ts"
    ],
    "reporter": [
      "text",
      "lcov"
    ],
    "all": true,
    "check-coverage": true,
    "lines": 90,
    "functions": 90,
    "branches": 80,
    "statements": 90
  }
}